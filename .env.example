# Copy to .env and fill in. Never commit .env.

# Any OpenAI-compatible endpoint: the SDK appends /chat/completions to this base URL.
LUNAS_LLM_BASE_URL=
LUNAS_LLM_API_KEY=
LUNAS_LLM_MODEL=
LUNAS_VISION_MODEL=
# How the endpoint is asked for JSON: json_schema (strict) | json_object | none
LUNAS_LLM_STRUCTURED_OUTPUT=json_schema
# system | user. "user" folds the system prompt into the user message, for endpoints
# that drop system messages.
LUNAS_LLM_SYSTEM_ROLE=system
# Parallel LLM calls in batch runs. Use 1 if the key has a concurrency limit.
LUNAS_LLM_WORKERS=4
# For rate-limited keys: more retries, and a minimum gap between requests (seconds).
LUNAS_LLM_MAX_RETRIES=2
LUNAS_LLM_MIN_INTERVAL_SECONDS=0
# Optional. Leave unset for models that reject an explicit temperature.
# LUNAS_LLM_TEMPERATURE=0

# auto | pdf_text | ocr | vision
LUNAS_INGEST_MODE=auto

LUNAS_DATABASE_URL=postgresql://lunas:lunas@localhost:5432/lunas
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
